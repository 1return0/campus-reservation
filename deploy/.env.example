MYSQL_ROOT_PASSWORD=replace-with-a-local-root-password
MYSQL_APP_PASSWORD=replace-with-a-local-app-password
RABBITMQ_APP_PASSWORD=replace-with-a-local-rabbit-password
REDIS_PASSWORD=replace-with-a-local-redis-password

# These values are imported by every Spring Boot service when it starts from
# the repository root. Process environment variables still take precedence.
NACOS_DISCOVERY_ENABLED=false
NACOS_SERVER_ADDR=127.0.0.1:8848
CAMPUS_TIME_ZONE=Asia/Shanghai

IDENTITY_DB_URL=jdbc:mysql://127.0.0.1:3306/campus_identity?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
IDENTITY_DB_USERNAME=campus_app
IDENTITY_DB_PASSWORD=replace-with-identity-db-password
CAMPUS_RESERVE_DB_URL=jdbc:mysql://127.0.0.1:3306/campus_reserve?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
CAMPUS_RESERVE_DB_USERNAME=campus_app
CAMPUS_RESERVE_DB_PASSWORD=replace-with-reservation-db-password
NOTIFICATION_DB_URL=jdbc:mysql://127.0.0.1:3306/campus_notification?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
NOTIFICATION_DB_USERNAME=campus_app
NOTIFICATION_DB_PASSWORD=replace-with-notification-db-password

RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_VIRTUAL_HOST=campusreserve
RABBITMQ_USERNAME=campusreserve_rabbit
RABBITMQ_PASSWORD=replace-with-rabbit-password

# Shared by gateway, identity-service, reservation-service and notification-service.
# Generate at least 32 random bytes, then Base64 encode them.
CAMPUS_JWT_HMAC_SECRET=replace-with-base64-encoded-32-byte-secret
CAMPUS_JWT_ISSUER=campus-reserve

# Optional local-only bootstrap account. All three values must be set together.
# It is created once on identity-service startup and is never overwritten.
CAMPUS_BOOTSTRAP_ADMIN_USERNAME=
CAMPUS_BOOTSTRAP_ADMIN_PASSWORD=
CAMPUS_BOOTSTRAP_ADMIN_DISPLAY_NAME=

OUTBOX_DELIVERY_ENABLED=false
RESERVATION_EVENT_CONSUMER_ENABLED=false
# Redis is an optional read cache. MySQL remains the quota and reservation source of truth.
RESERVATION_REDIS_ENABLED=false
RESERVATION_REDIS_HOST=127.0.0.1
RESERVATION_REDIS_PORT=6379
RESERVATION_REDIS_PASSWORD=
RESERVATION_REDIS_RESOURCE_TTL_SECONDS=300
RESERVATION_REDIS_SLOT_TTL_SECONDS=30
RESERVATION_REDIS_STUDY_ROOM_WINDOWS_TTL_SECONDS=20
# Optional cache-expiry jitter and hot-slot admission protection. Admission
# remains disabled unless Redis is intentionally made an availability dependency.
RESERVATION_REDIS_TTL_JITTER_MILLIS=0
RESERVATION_ADMISSION_RATE_LIMIT_ENABLED=false
RESERVATION_ADMISSION_RATE_LIMIT_WINDOW_MILLIS=1000
RESERVATION_ADMISSION_PER_SLOT_MAX_REQUESTS=80
RESERVATION_ADMISSION_PER_USER_PER_SLOT_MAX_REQUESTS=3
STUDY_ROOM_ADMISSION_ENABLED=false
STUDY_ROOM_ADMISSION_WINDOW_MILLIS=1000
STUDY_ROOM_ADMISSION_PER_ROOM_DAY_MAX_REQUESTS=80
STUDY_ROOM_ADMISSION_PER_USER_PER_ROOM_DAY_MAX_REQUESTS=3
RESERVATION_SERVICE_URI=http://127.0.0.1:8202
IDENTITY_SERVICE_URI=http://127.0.0.1:8201
NOTIFICATION_SERVICE_URI=http://127.0.0.1:8203
